<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_description</name>
  <version>0.1.0</version>
  <description>
    Hexapod simülasyon modeli: config/robot.yaml'dan kütle, atalet,
    çarpışma kutuları ve eklem limitleri; URDF üretiminin girdisi.
    Saf Python, ROS olmadan da çalışır.
  </description>
  <maintainer email="gorkemmutlu227@gmail.com">hexapod takımı</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>hexapod_driver</exec_depend>
  <exec_depend>hexapod_kinematics</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Yalnızca launch/display.launch.py için; çekirdek (model, urdf) ROS'suz çalışır. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <!-- Gazebo package://hexapod_description/meshes/... yolunu bulsun diye
         (ros_gz_sim gz_sim.launch.py bunu GZ_SIM_RESOURCE_PATH'e ekler). -->
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>
