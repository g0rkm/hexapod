<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_gazebo</name>
  <version>0.1.0</version>
  <description>
    Hexapod'un Gazebo simülasyonu: dünyalar, simülasyon launch dosyası ve
    ros2_control kontrolcüleri. Robot modeli ve eklem arayüzü
    hexapod_description'da.
  </description>
  <maintainer email="gorkemmutlu227@gmail.com">hexapod takımı</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>hexapod_kinematics</exec_depend>
  <exec_depend>hexapod_driver</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
