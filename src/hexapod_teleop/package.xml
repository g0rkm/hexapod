<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_teleop</name>
  <version>0.1.0</version>
  <description>
    Hız komutunu (geometry_msgs/Twist) hexapod_gait.TripodGait ile eklem
    açısına çevirip komut arayüzüne yayınlayan ROS 2 düğümü (GOREVLER.md S3).
    Ayrıca WASD klavye kumandası (wasd): terminalden /cmd_vel yayınlar.
  </description>
  <maintainer email="sametoruc74@gmail.com">hexapod takımı</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>hexapod_gait</exec_depend>
  <exec_depend>hexapod_kinematics</exec_depend>
  <exec_depend>hexapod_driver</exec_depend>
  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
