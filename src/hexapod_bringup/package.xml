<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_bringup</name>
  <version>0.1.0</version>
  <description>
    Gerçek robotu tek komutla başlatır: sensör düğümü (hexapod_sensors),
    servo sürücü düğümü (hexapod_hardware) ve politika düğümü
    (hexapod_policy). Robot olmadan dry_run:=true ile denenir.
  </description>
  <maintainer email="gorkemmutlu227@gmail.com">hexapod takımı</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>hexapod_sensors</exec_depend>
  <exec_depend>hexapod_hardware</exec_depend>
  <exec_depend>hexapod_policy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
