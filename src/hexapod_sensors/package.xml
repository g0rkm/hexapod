<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_sensors</name>
  <version>0.1.0</version>
  <description>
    VL53L0X mesafe sensörü ve BNO055 IMU sürücüleri (GOREVLER.md S7).
    Çekirdek saf Python, robotsuz test edilir; düğüm /range* ve /imu yayınlar.
    DONANIMDA DENENMEDİ: ilk çalıştırma donanım vardiyasında (D8).
  </description>
  <maintainer email="sametoruc74@gmail.com">hexapod takımı</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>hexapod_driver</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
